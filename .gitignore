# =============================================================================
# pdftoolkit - Unified Headless PDF Engine
# .gitignore
#
# Single-application repository: one Python engine (src/pdftoolkit) plus its
# test suite. Patterns are relative to the repository root and match anything
# below it.
# =============================================================================

# ---------------------------------------------------------------------------
# Operating system junk
# ---------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
.Spotlight-V100
.Trashes
.NFS
.AppleDouble
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
# Vim / Neovim swap, backup and session files
*~
*.swp
*.swo
*.swx
*.bak
*.orig
*.rej
Session.vim
# Emacs
*~
#*#
.\#
auto-save-files
.session
# Midnight Commander
.mc_*
# Thumbnails / cache
*.cache/thumbnails/

# ---------------------------------------------------------------------------
# Python virtual environments, caches and build artifacts
# ---------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
env/
ENV/
# pip
pip-log.txt
pip-delete-this-directory.txt
# Byte-compiled / optimized / debug
__pycache__/
*.py[cod]
*$py.class
# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
*.egg
*.manifest
*.spec
# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pytype/
# Translations
*.mo
*.pot
# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Editor / IDE settings
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
.python-version

# ---------------------------------------------------------------------------
# Local environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Generated output (never commit engine outputs)
# ---------------------------------------------------------------------------
output/
out/
temp/
tmp/
*.tmp
*.temp
merged.pdf
.venv/
build*/
native/build/
